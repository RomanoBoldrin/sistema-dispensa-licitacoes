{
  "name": "sistema-dispensa-licitacoes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.development -- next dev -p 3000",
    "dev:test": "dotenv -e .env.test -- next dev -p 3000",
    "test": "dotenv -e .env.test -- jest --runInBand --verbose",
    "test:watch": "dotenv -e .env.test -- jest --watchAll --runInBand --verbose",
    "test:dev": "concurrently -k -s first --hide next -n next,tests \"npm run dev:test\" \"npm run services:wait && npm run test\"",
    "test:ci": "dotenv -e .env.test -- prisma migrate reset --force && dotenv -e .env.test -- jest --runInBand --verbose",
    "services:wait": "dotenv -e .env.test -- cross-env NODE_ENV=test node src/tests/orchestrator/wait-for-services.mjs",
    "build": "prisma generate && next build",
    "db:migrate:deploy": "prisma migrate deploy",
    "start": "next start -p 3000",
    "prepare": "husky",
    "db:generate": "dotenv -e .env.development -- prisma generate",
    "db:migrate": "dotenv -e .env.development -- prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "dotenv -e .env.development -- prisma db push",
    "db:studio": "dotenv -e .env.development -- prisma studio",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier . --write --ignore-path=.prettierignore",
    "lint:eslint:check": "eslint . --max-warnings=0",
    "lint:eslint:fix": "eslint . --fix",
    "db:seed:admin": "node src/scripts/seed-admin.mjs",
    "db:seed:admin:dev": "dotenv -e .env.development -- npm run db:seed:admin",
    "db:seed:admin:test": "dotenv -e .env.test -- npm run db:seed:admin",
    "db:seed:admin:prod": "dotenv -e .env.production -- npm run db:seed:admin"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "3.0.3",
    "cookie": "2.0.1",
    "next": "16.3.0",
    "next-connect": "1.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tailwindcss/postcss": "^4",
    "async-retry": "1.3.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "husky": "9.1.7",
    "jest": "^30.4.2",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "tailwindcss": "^4"
  }
}
